{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronotope",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-04-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "chronotope.acxx.art", "custom_domain": true }
  ]
}
